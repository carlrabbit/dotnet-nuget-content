{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carlrabbit/dotnet-nuget-content/blob/main/docs/specs/M0007-workspace-inspect.schema.json",
  "title": "Workspace inspection result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "members", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "workspaceInspect" },
    "members": { "type": "array", "items": { "$ref": "#/$defs/member" } },
    "diagnostics": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "member": {
      "type": "object", "additionalProperties": false,
      "required": ["alias", "packageId", "version", "packageFile", "directory", "state", "added", "modified", "deleted", "consumers", "candidates"],
      "properties": {
        "alias": { "type": "string" }, "packageId": { "type": "string" }, "version": { "type": "string" },
        "packageFile": { "type": "string" }, "directory": { "type": "string" },
        "state": { "enum": ["missing", "clean", "modified", "corrupt", "mismatched"] },
        "added": { "$ref": "#/$defs/paths" }, "modified": { "$ref": "#/$defs/paths" }, "deleted": { "$ref": "#/$defs/paths" },
        "consumers": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "kind", "state"], "properties": {
          "path": { "type": "string" }, "kind": { "enum": ["direct", "central"] }, "state": { "enum": ["pinned", "drift", "dynamic", "unresolved"] }, "version": { "type": ["string", "null"] }
        } } },
        "candidates": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["directory", "version", "state"], "properties": {
          "directory": { "type": "string" }, "version": { "type": "string" }, "state": { "enum": ["clean", "modified"] }
        } } },
        "error": { "type": ["string", "null"] }
      }
    },
    "paths": { "type": "array", "items": { "type": "string" } }
  }
}
