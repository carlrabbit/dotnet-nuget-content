{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/carlrabbit/dotnet-nuget-content/blob/main/docs/specs/M0005-project-workspace.schema.json",
  "title": "dotnet-nuget-content project workspace marker v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "members"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "members": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["alias", "packageId", "version", "packageFile", "directory"],
        "properties": {
          "alias": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
          "packageId": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$" },
          "version": { "type": "string", "minLength": 1 },
          "packageFile": { "type": "string", "minLength": 1 },
          "directory": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
