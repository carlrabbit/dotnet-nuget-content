<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>1.0.0</Version>
    <PackageId>dotnet-nuget-content</PackageId>
    <Title>dotnet-nuget-content — immutable content snapshots</Title>
    <Description>Windows command-line tool for creating and maintaining immutable NuGet packages of arbitrary files. Supports versioned snapshots, workspace status, change history, SHA-256 verification, and JSON output. Generated packages integrate with ordinary .NET PackageReference consumers.</Description>
    <Authors>Martin Koch</Authors>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/carlrabbit/dotnet-nuget-content</PackageProjectUrl>
    <RepositoryUrl>https://github.com/carlrabbit/dotnet-nuget-content</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet-tool nuget content files snapshots versioning nativeaot</PackageTags>
    <PackageReleaseNotes>First stable Windows x64 Native AOT .NET tool release. Immutable arbitrary-content package snapshots, managed workspace status and repack, manifest v1, history, SHA-256 validation, JSON inspection, and ordinary PackageReference consumption.</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-nuget-content</ToolCommandName>
    <ToolPackageRuntimeIdentifiers>win-x64</ToolPackageRuntimeIdentifiers>
    <AssemblyName>dotnet-nuget-content</AssemblyName>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <InternalsVisibleTo Include="DotnetNugetContent.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../docs/nuget/README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

</Project>
