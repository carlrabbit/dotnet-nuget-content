<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.1.0</Version>
    <PackageId>dotnet-nuget-content</PackageId>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>dotnet-nuget-content</ToolCommandName>
    <ToolPackageRuntimeIdentifiers>win-x64</ToolPackageRuntimeIdentifiers>
    <AssemblyName>dotnet-nuget-content</AssemblyName>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Packaging" Version="7.9.0" />
    <InternalsVisibleTo Include="DotnetNugetContent.Tests" />
  </ItemGroup>

</Project>
